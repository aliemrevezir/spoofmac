#!/bin/zsh
# spoofmac — SpoofDPI on macOS: open Discord through it, and log in to public Wi-Fi without a fight.
# MIT License — https://github.com/aliemrevezir/spoofmac

emulate -R zsh
set -u

readonly SPOOFMAC_VERSION="0.2.0"

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/spoofmac/config"
LOG_DIR="$HOME/Library/Logs/spoofmac"
LABEL="local.spoofmac.spoofdpi"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"
PROBE_URL="http://captive.apple.com/hotspot-detect.html"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
LAUNCHER_ID="local.spoofmac.discord"

# ---- Defaults (optional overrides in $CONFIG_FILE; run `spoofmac install` after changing) ----
SPOOFDPI_BIN=""
LISTEN_HOST="127.0.0.1"
LISTEN_PORT="8080"
# SpoofDPI resolves names itself; plain UDP 53 is blocked or hijacked on many networks.
DOH_URL="https://1.1.1.1/dns-query"
# SpoofDPI's default ("sni") was reset by the DPI where we tested; 5-byte chunks got through.
SPLIT_MODE="chunk"
CHUNK_SIZE="5"
EXTRA_ARGS=()

[[ -r "$CONFIG_FILE" ]] && source "$CONFIG_FILE"
PROXY_URL="http://$LISTEN_HOST:$LISTEN_PORT"

# ---- Language: Turkish when the system (or SPOOFMAC_LANG) says so ----
detect_lang() {
  local l="${SPOOFMAC_LANG:-${LC_ALL:-${LANG:-}}}"
  [[ -z "$l" ]] && l=$(defaults read -g AppleLanguages 2>/dev/null | awk -F'"' 'NF>1 {print $2; exit}')
  [[ "$l" == tr* ]] && print 1 || print 0
}
TR=$(detect_lang)

t()   { if (( TR )); then print -r -- "$2"; else print -r -- "$1"; fi }
say() { t "$@" }
die() { t "$@" >&2; exit 1 }
row() { printf '%-20s %s\n' "$1" "$2" }

# ---- SpoofDPI ----
find_spoofdpi() {
  local c
  for c in "$SPOOFDPI_BIN" "${commands[spoofdpi]:-}" /opt/homebrew/bin/spoofdpi /usr/local/bin/spoofdpi; do
    [[ -n "$c" && -x "$c" ]] && { print -r -- "$c"; return 0 }
  done
  return 1
}

# "spoofdpi 1.5.3 f31018f (homebrew)" -> 1.5.3. Pre-1.0 builds have no --version.
spoofdpi_version() { "$1" --version 2>/dev/null | awk 'NR == 1 && $1 == "spoofdpi" {print $2}' }

# ---- System proxy (set on every enabled service, so Wi-Fi <-> Ethernet <-> iPhone keeps working) ----
network_services() { networksetup -listallnetworkservices 2>/dev/null | tail -n +2 | grep -v '^\*' }

wifi_device() {
  networksetup -listallhardwareports 2>/dev/null | awk '/^Hardware Port: (Wi-Fi|AirPort)$/ {getline; print $2; exit}'
}

proxy_is_ours() {
  local out=$'\n'"$(networksetup -getsecurewebproxy "$1" 2>/dev/null)"$'\n'
  [[ "$out" == *$'\n'"Enabled: Yes"$'\n'* &&
     "$out" == *$'\n'"Server: $LISTEN_HOST"$'\n'* &&
     "$out" == *$'\n'"Port: $LISTEN_PORT"$'\n'* ]]
}

proxy_on() {
  local s
  for s in "${(@f)$(network_services)}"; do
    networksetup -setwebproxy "$s" "$LISTEN_HOST" "$LISTEN_PORT" >/dev/null
    networksetup -setsecurewebproxy "$s" "$LISTEN_HOST" "$LISTEN_PORT" >/dev/null
  done
}

# Only switches off proxies that point at SpoofDPI; a corporate proxy is left alone.
proxy_off() {
  local s
  for s in "${(@f)$(network_services)}"; do
    proxy_is_ours "$s" || continue
    networksetup -setwebproxystate "$s" off
    networksetup -setsecurewebproxystate "$s" off
  done
}

# ---- Background service (LaunchAgent) ----
agent_loaded() { launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1 }
port_open()    { nc -z "$LISTEN_HOST" "$LISTEN_PORT" >/dev/null 2>&1 }
port_owner()   { lsof -nP -iTCP:"$LISTEN_PORT" -sTCP:LISTEN 2>/dev/null | awk 'NR == 2 {print $1 " (pid " $2 ")"}' }

xml_escape() { local s=${1//&/&amp;}; s=${s//</&lt;}; print -r -- "${s//>/&gt;}" }

write_plist() {
  local bin=$1 a
  local -a args=(
    "$bin" --clean --no-tui
    --listen-addr "$LISTEN_HOST:$LISTEN_PORT"
    --dns-mode https --dns-https-url "$DOH_URL" --dns-cache
    --https-split-mode "$SPLIT_MODE" --https-chunk-size "$CHUNK_SIZE"
    --log-level warn
    "${EXTRA_ARGS[@]}"
  )
  mkdir -p "${PLIST:h}" "$LOG_DIR"
  {
    print -r -- '<?xml version="1.0" encoding="UTF-8"?>'
    print -r -- '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
    print -r -- '<plist version="1.0">'
    print -r -- '<dict>'
    print -r -- "  <key>Label</key><string>$LABEL</string>"
    print -r -- '  <key>ProgramArguments</key>'
    print -r -- '  <array>'
    for a in "${args[@]}"; do print -r -- "    <string>$(xml_escape "$a")</string>"; done
    print -r -- '  </array>'
    print -r -- '  <key>RunAtLoad</key><true/>'
    print -r -- '  <key>KeepAlive</key><true/>'
    print -r -- "  <key>StandardOutPath</key><string>$(xml_escape "$LOG_DIR/spoofdpi.log")</string>"
    print -r -- "  <key>StandardErrorPath</key><string>$(xml_escape "$LOG_DIR/spoofdpi.log")</string>"
    print -r -- '</dict>'
    print -r -- '</plist>'
  } > "$PLIST"
  plutil -lint "$PLIST" >/dev/null || die "Generated LaunchAgent is invalid: $PLIST" "Oluşturulan LaunchAgent geçersiz: $PLIST"
}

agent_start() {
  launchctl enable "$DOMAIN/$LABEL" 2>/dev/null
  agent_loaded || launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null || return 1
  local i
  for i in {1..20}; do port_open && return 0; sleep 0.5; done
  return 1
}

# `disable` survives reboots: "off" stays off until you say "on".
agent_stop() {
  agent_loaded && launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null
  launchctl disable "$DOMAIN/$LABEL" 2>/dev/null
  local i
  for i in {1..10}; do agent_loaded || return 0; sleep 0.5; done
}

# ---- Probes ----
# online | captive | offline — asked directly, never through the proxy.
internet_state() {
  local body
  body=$(curl -s --noproxy '*' -m 5 "$PROBE_URL" 2>/dev/null) || { print offline; return }
  [[ "$body" == *Success* ]] && print online || print captive
}

code_via_proxy() { curl -s -m "${2:-10}" -x "$PROXY_URL" -o /dev/null -w '%{http_code}' "$1" 2>/dev/null }
code_ok()        { [[ "$1" == [23]?? ]] }
proxy_alive()    { code_ok "$(code_via_proxy https://www.google.com 8)" }

# ---- Commands ----
cmd_install() {
  local bin ver
  bin=$(find_spoofdpi) || die \
    "SpoofDPI not found. Install it first: brew install spoofdpi  (https://github.com/xvzc/SpoofDPI)" \
    "SpoofDPI bulunamadı. Önce kur: brew install spoofdpi  (https://github.com/xvzc/SpoofDPI)"
  ver=$(spoofdpi_version "$bin")
  [[ "${ver%%.*}" == <1-> ]] || die \
    "spoofmac needs SpoofDPI 1.x (found ${ver:-a pre-1.0 build} at $bin). Update: brew upgrade spoofdpi" \
    "spoofmac SpoofDPI 1.x ister ($bin: ${ver:-1.0 öncesi bir sürüm}). Güncelle: brew upgrade spoofdpi"

  # Something else on our port (brew services, an older setup) would silently take our traffic.
  if port_open && ! agent_loaded; then
    die "Port $LISTEN_PORT is already taken by $(port_owner). Stop it first (e.g. brew services stop spoofdpi)." \
        "$LISTEN_PORT portunu zaten $(port_owner) kullanıyor. Önce onu durdur (ör. brew services stop spoofdpi)."
  fi

  agent_stop                  # so a rewritten plist is picked up
  write_plist "$bin"
  cmd_on
  say "Next: spoofmac discord" "Sıradaki: spoofmac discord"
}

cmd_on() {
  [[ -f "$PLIST" ]] || die "Not installed yet. Run: spoofmac install" "Henüz kurulmadı. Çalıştır: spoofmac install"
  local state; state=$(internet_state)
  if [[ "$state" == captive ]]; then
    die "This network wants you to log in first. Run: spoofmac portal" \
        "Bu ağ önce giriş yapmanı istiyor. Çalıştır: spoofmac portal"
  fi
  agent_start || die "SpoofDPI did not start. See: spoofmac logs" "SpoofDPI başlamadı. Bak: spoofmac logs"
  proxy_on
  dscacheutil -flushcache 2>/dev/null

  if proxy_alive; then
    say "✓ SpoofDPI is on" "✓ SpoofDPI açık"
  elif [[ "$state" == offline ]]; then
    say "✓ SpoofDPI is on (you're offline right now)" "✓ SpoofDPI açık (şu an internet yok)"
  else
    # Online, but not through SpoofDPI: a proxy that goes nowhere means no internet at all.
    proxy_off
    agent_stop
    die "SpoofDPI can't reach the internet on this network, so it was switched off again. See: spoofmac doctor" \
        "SpoofDPI bu ağda internete çıkamıyor, o yüzden tekrar kapatıldı. Bak: spoofmac doctor"
  fi
}

cmd_off() {
  proxy_off                   # proxy first, so nothing is left pointing at a dead port
  agent_stop
  dscacheutil -flushcache 2>/dev/null
  say "✓ SpoofDPI is off" "✓ SpoofDPI kapalı"
}

cmd_portal() {
  cmd_off >/dev/null
  if [[ -n "${1:-}" ]]; then
    local dev i; dev=$(wifi_device)
    [[ -n "$dev" ]] || die "No Wi-Fi interface found." "Wi-Fi arayüzü bulunamadı."
    say "Joining \"$1\"..." "\"$1\" ağına bağlanılıyor..."
    networksetup -setairportnetwork "$dev" "$1" || die "Could not join \"$1\"." "\"$1\" ağına bağlanılamadı."
    for i in {1..20}; do [[ -n "$(ipconfig getifaddr "$dev" 2>/dev/null)" ]] && break; sleep 1; done
    sleep 2                   # DHCP done; give the portal a moment to start intercepting
  fi

  case "$(internet_state)" in
    online)
      say "No login page here, you're already online. Run: spoofmac on" \
          "Burada giriş sayfası yok, internet zaten açık. Çalıştır: spoofmac on" ;;
    *)
      open "http://captive.apple.com"   # plain HTTP, so the portal can intercept and redirect it
      say "SpoofDPI paused. Log in on the page that just opened, then run: spoofmac on" \
          "SpoofDPI durduruldu. Açılan sayfada giriş yap, sonra çalıştır: spoofmac on" ;;
  esac
}

# Discord's window follows the system proxy, but its updater doesn't: it connects directly and
# never gets past "Checking for updates…". It does read HTTPS_PROXY, so we start Discord with it.
cmd_discord() {
  local src="" c dest info icon_file icon
  for c in "/Applications/Discord.app" "$HOME/Applications/Discord.app"; do
    [[ -d "$c" ]] && { src=$c; break }
  done
  [[ -n "$src" ]] || die "Discord is not installed: https://discord.com/download" "Discord kurulu değil: https://discord.com/download"
  port_open || die "SpoofDPI isn't running. Run: spoofmac install" "SpoofDPI çalışmıyor. Çalıştır: spoofmac install"

  local apps_dir="${SPOOFMAC_APPS_DIR:-/Applications}"
  [[ -w "$apps_dir" ]] || apps_dir="$HOME/Applications"
  mkdir -p "$apps_dir"
  dest="$apps_dir/Discord SpoofDPI.app"

  if [[ "$(plutil -extract CFBundleIdentifier raw "$dest/Contents/Info.plist" 2>/dev/null)" != "$LAUNCHER_ID" ]]; then
    # Never write onto an existing bundle: it would nest inside it and break the signature.
    [[ -e "$dest" ]] && { mv "$dest" "$HOME/.Trash/Discord SpoofDPI $(date +%Y%m%d-%H%M%S).app" ||
      die "Could not move the old $dest to the Trash." "Eski $dest Çöp Sepeti'ne taşınamadı." }

    local envs="--env HTTPS_PROXY=$PROXY_URL --env HTTP_PROXY=$PROXY_URL --env NO_PROXY=localhost,127.0.0.1,::1"
    osacompile -o "$dest" -e "do shell script \"open -a \" & quoted form of \"$src\" & \" $envs\"" 2>/dev/null ||
      die "osacompile failed." "osacompile başarısız oldu."

    info="$dest/Contents/Info.plist"
    plutil -replace CFBundleIdentifier -string "$LAUNCHER_ID" "$info"   # without it, launchers stay invisible to search
    icon_file=$(plutil -extract CFBundleIconFile raw "$src/Contents/Info.plist" 2>/dev/null)
    icon="$src/Contents/Resources/${icon_file%.icns}.icns"
    if [[ -n "$icon_file" && -f "$icon" ]]; then
      cp "$icon" "$dest/Contents/Resources/applet.icns"
      plutil -remove CFBundleIconName "$info" 2>/dev/null         # else Assets.car's icon wins
      rm -f "$dest/Contents/Resources/Assets.car"
    fi
    codesign --force --deep -s - "$dest" >/dev/null 2>&1 && codesign --verify "$dest" 2>/dev/null ||
      die "Could not sign $dest" "$dest imzalanamadı"
    touch "$dest"
    [[ -x "$LSREGISTER" ]] && "$LSREGISTER" -f "$dest" 2>/dev/null
    mdimport "$dest" 2>/dev/null
  fi

  [[ -n "${SPOOFMAC_NO_OPEN:-}" ]] && { print -r -- "$dest"; return 0 }

  # An already running Discord keeps its old environment, so restart it.
  if pgrep -xq Discord; then
    osascript -e 'quit app "Discord"' 2>/dev/null
    local i; for i in {1..10}; do pgrep -xq Discord || break; sleep 1; done
  fi
  open "$dest"
  say "✓ Discord is opening through SpoofDPI.
  From now on, open \"Discord SpoofDPI\" (Applications) instead of Discord, or run: spoofmac discord" \
      "✓ Discord SpoofDPI üzerinden açılıyor.
  Bundan sonra Discord yerine \"Discord SpoofDPI\"yı aç (Uygulamalar), ya da çalıştır: spoofmac discord"
}

cmd_doctor() {
  local host="${1:-discord.com}" s any=0 sys udp rc code
  local -a doh
  print -r -- "spoofmac doctor · $host"
  print

  if port_open && agent_loaded; then row "SpoofDPI" "$(t "running on $LISTEN_HOST:$LISTEN_PORT" "çalışıyor, $LISTEN_HOST:$LISTEN_PORT")"
  elif port_open;               then row "SpoofDPI" "$(t "port $LISTEN_PORT is used by $(port_owner)" "$LISTEN_PORT portunu $(port_owner) kullanıyor")"
  else                               row "SpoofDPI" "$(t stopped durdu)"
  fi
  for s in "${(@f)$(network_services)}"; do proxy_is_ours "$s" && any=1; done
  row "$(t "System proxy" "Sistem proxy'si")" "$( (( any )) && print "$PROXY_URL" || t off kapalı)"
  row "$(t Internet İnternet)" "$(internet_state)"

  doh=( ${(f)"$(curl -s --noproxy '*' -m 6 -H 'accept: application/dns-json' \
          "https://1.1.1.1/dns-query?name=$host&type=A" 2>/dev/null | grep -oE '"data":"[0-9.]+"' | cut -d'"' -f4)"} )
  sys=$(dscacheutil -q host -a name "$host" 2>/dev/null | awk '/^ip_address/ {print $2; exit}')
  udp=$(dig +short +time=2 +tries=1 @1.1.1.1 "$host" A 2>/dev/null | grep -E '^[0-9.]+$' | head -1)

  local dns_bad=0
  if [[ -n "$sys" && ${#doh} -gt 0 && ${doh[(Ie)$sys]} -eq 0 ]]; then
    dns_bad=1
    row "$(t "System DNS" "Sistem DNS'i")" "✗ $sys ($(t "real: ${doh[1]}" "gerçeği: ${doh[1]}"))"
  else
    row "$(t "System DNS" "Sistem DNS'i")" "${sys:-$(t "no answer" "yanıt yok")}"
  fi
  row "UDP 53" "${udp:-$(t blocked kapalı)}"

  # Direct HTTPS to the real IP: DNS is out of the picture, only DPI/SNI filtering is left.
  local dpi_bad=0
  if (( ${#doh} )); then
    curl -s --noproxy '*' -m 8 -o /dev/null --resolve "$host:443:${doh[1]}" "https://$host/" 2>/dev/null
    rc=$?
    if (( rc == 0 )); then row "$(t "Direct HTTPS" "Doğrudan HTTPS")" "✓"
    else dpi_bad=1; row "$(t "Direct HTTPS" "Doğrudan HTTPS")" "✗ $(t "blocked (DPI)" "engelli (DPI)") · curl $rc"
    fi
  fi

  local spoof_ok=0
  if port_open; then
    code=$(code_via_proxy "https://$host/")
    code_ok "$code" && spoof_ok=1
    row "$(t "Via SpoofDPI" "SpoofDPI üstünden")" "$( (( spoof_ok )) && print "✓ $code" || print "✗ ${code:-000}")"
  fi

  print
  if (( ! dns_bad && ! dpi_bad )); then
    say "Nothing blocks $host here." "Burada $host için engel yok."
  elif port_open && (( spoof_ok )); then
    say "$host is blocked here, and SpoofDPI gets through." "$host burada engelli, SpoofDPI geçiyor."
  elif port_open; then
    say "SpoofDPI doesn't get through. Try CHUNK_SIZE=\"1\" or SPLIT_MODE=\"random\" in $CONFIG_FILE, then: spoofmac install" \
        "SpoofDPI geçemiyor. $CONFIG_FILE içine CHUNK_SIZE=\"1\" ya da SPLIT_MODE=\"random\" yaz, sonra: spoofmac install"
  else
    say "$host is blocked here. Turn SpoofDPI on: spoofmac on" "$host burada engelli. SpoofDPI'ı aç: spoofmac on"
  fi
}

cmd_logs() {
  [[ -f "$LOG_DIR/spoofdpi.log" ]] || die "No log yet: $LOG_DIR/spoofdpi.log" "Henüz log yok: $LOG_DIR/spoofdpi.log"
  tail -n 50 -f "$LOG_DIR/spoofdpi.log"
}

cmd_uninstall() {
  cmd_off >/dev/null
  [[ -f "$PLIST" ]] && rm -f "$PLIST"
  say "✓ Removed. You can delete \"Discord SpoofDPI\" from Applications." \
      "✓ Kaldırıldı. \"Discord SpoofDPI\"yı Uygulamalar'dan silebilirsin."
}

usage() {
  say "spoofmac $SPOOFMAC_VERSION

  spoofmac install          start SpoofDPI (and at every login)
  spoofmac discord          open Discord through SpoofDPI
  spoofmac portal [WIFI]    public Wi-Fi: pause SpoofDPI and open the login page
  spoofmac on | off         turn SpoofDPI on / off

  spoofmac doctor [HOST]    what blocks HOST here (default: discord.com)
  spoofmac logs             follow SpoofDPI's log
  spoofmac uninstall        remove everything" \
      "spoofmac $SPOOFMAC_VERSION

  spoofmac install          SpoofDPI'ı başlat (her oturum açılışında da)
  spoofmac discord          Discord'u SpoofDPI üzerinden aç
  spoofmac portal [WIFI]    giriş sayfalı Wi-Fi: SpoofDPI'ı durdur, giriş sayfasını aç
  spoofmac on | off         SpoofDPI'ı aç / kapat

  spoofmac doctor [ADRES]   burada ADRES'i ne engelliyor (varsayılan: discord.com)
  spoofmac logs             SpoofDPI logunu izle
  spoofmac uninstall        her şeyi kaldır"
}

case "${1:-help}" in
  install)              cmd_install ;;
  discord)              cmd_discord ;;
  portal)               shift; cmd_portal "$@" ;;
  on)                   cmd_on ;;
  off)                  cmd_off ;;
  doctor)               shift; cmd_doctor "$@" ;;
  logs)                 cmd_logs ;;
  uninstall)            cmd_uninstall ;;
  version|-v|--version) print -r -- "spoofmac $SPOOFMAC_VERSION" ;;
  help|-h|--help)       usage ;;
  *)                    usage >&2; exit 64 ;;
esac
