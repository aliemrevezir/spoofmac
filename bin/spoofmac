#!/bin/zsh
# spoofmac — SpoofDPI on macOS, minus the pain.
#
# One command to turn SpoofDPI on and off, a public Wi-Fi (captive portal) mode,
# launchers for apps that ignore the macOS system proxy (Discord's updater, for one)
# and a doctor that tells you *what* is being blocked: DNS, SNI/DPI, or nothing.
#
# MIT License — https://github.com/aliemrevezir/spoofmac

emulate -R zsh
set -u

readonly SPOOFMAC_VERSION="0.1.0"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/spoofmac"
CONFIG_FILE="$CONFIG_DIR/config"
LOG_DIR="$HOME/Library/Logs/spoofmac"
LABEL="local.spoofmac.spoofdpi"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"
PROBE_URL="http://captive.apple.com/hotspot-detect.html"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

# ---- Defaults — override any of these in $CONFIG_FILE, then run `spoofmac install` ----
SPOOFDPI_BIN=""
LISTEN_HOST="127.0.0.1"
LISTEN_PORT="8080"
# SpoofDPI resolves hostnames itself. Plain UDP 53 is blocked or hijacked on many
# networks, so it asks a DoH server by IP (no bootstrap lookup needed).
DOH_URL="https://1.1.1.1/dns-query"
# SpoofDPI's default ("sni") was reset by the DPI on the networks we tested;
# 5-byte chunks got through. "random" worked as well.
SPLIT_MODE="chunk"
CHUNK_SIZE="5"
EXTRA_ARGS=()
TEST_URL="https://discord.com/api/v9/gateway"

[[ -r "$CONFIG_FILE" ]] && source "$CONFIG_FILE"
PROXY_URL="http://$LISTEN_HOST:$LISTEN_PORT"

# ---- Language: Turkish when the system (or SPOOFMAC_LANG) says so ----
detect_lang() {
  local l="${SPOOFMAC_LANG:-${LC_ALL:-${LANG:-}}}"
  [[ -z "$l" ]] && l=$(defaults read -g AppleLanguages 2>/dev/null | awk -F'"' 'NF>1 {print $2; exit}')
  [[ "$l" == tr* ]] && print 1 || print 0
}
TR=$(detect_lang)

t()    { if (( TR )); then print -r -- "$2"; else print -r -- "$1"; fi }
say()  { t "$@" }
warn() { t "$@" >&2 }
die()  { warn "$@"; exit 1 }
row()  { printf '%-22s %s\n' "$1" "$2" }

# ---- SpoofDPI binary ----
find_spoofdpi() {
  local c
  for c in "$SPOOFDPI_BIN" "${commands[spoofdpi]:-}" /opt/homebrew/bin/spoofdpi /usr/local/bin/spoofdpi; do
    [[ -n "$c" && -x "$c" ]] && { print -r -- "$c"; return 0 }
  done
  return 1
}

# "spoofdpi 1.5.3 f31018f (homebrew)" -> 1.5.3. Pre-1.0 builds have no --version and print nothing.
spoofdpi_version() { "$1" --version 2>/dev/null | awk 'NR == 1 && $1 == "spoofdpi" {print $2}' }

# ---- Network services & system proxy ----
network_services() { networksetup -listallnetworkservices 2>/dev/null | tail -n +2 | grep -v '^\*' }

wifi_device() {
  networksetup -listallhardwareports 2>/dev/null | awk '/^Hardware Port: (Wi-Fi|AirPort)$/ {getline; print $2; exit}'
}

# True when the service's HTTPS proxy is on and points at our SpoofDPI.
proxy_is_ours() {
  local out=$'\n'"$(networksetup -getsecurewebproxy "$1" 2>/dev/null)"$'\n'
  [[ "$out" == *$'\n'"Enabled: Yes"$'\n'* &&
     "$out" == *$'\n'"Server: $LISTEN_HOST"$'\n'* &&
     "$out" == *$'\n'"Port: $LISTEN_PORT"$'\n'* ]]
}

# Every enabled service gets the proxy, so switching Wi-Fi <-> Ethernet <-> iPhone keeps working.
proxy_on() {
  local s
  for s in "${(@f)$(network_services)}"; do
    networksetup -setwebproxy "$s" "$LISTEN_HOST" "$LISTEN_PORT" >/dev/null
    networksetup -setsecurewebproxy "$s" "$LISTEN_HOST" "$LISTEN_PORT" >/dev/null
  done
}

# Only switches off proxies that point at SpoofDPI; a corporate proxy is left alone.
proxy_off() {
  local s
  for s in "${(@f)$(network_services)}"; do
    proxy_is_ours "$s" || continue
    networksetup -setwebproxystate "$s" off
    networksetup -setsecurewebproxystate "$s" off
  done
}

# ---- LaunchAgent ----
agent_loaded() { launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1 }
port_open()    { nc -z "$LISTEN_HOST" "$LISTEN_PORT" >/dev/null 2>&1 }
port_owner()   { lsof -nP -iTCP:"$LISTEN_PORT" -sTCP:LISTEN 2>/dev/null | awk 'NR == 2 {print $1 " (pid " $2 ")"}' }

xml_escape() { local s=${1//&/&amp;}; s=${s//</&lt;}; print -r -- "${s//>/&gt;}" }

write_plist() {
  local bin=$1 a
  local -a args=(
    "$bin" --clean --no-tui
    --listen-addr "$LISTEN_HOST:$LISTEN_PORT"
    --dns-mode https --dns-https-url "$DOH_URL" --dns-cache
    --https-split-mode "$SPLIT_MODE" --https-chunk-size "$CHUNK_SIZE"
    --log-level warn
    "${EXTRA_ARGS[@]}"
  )
  mkdir -p "${PLIST:h}" "$LOG_DIR"
  {
    print -r -- '<?xml version="1.0" encoding="UTF-8"?>'
    print -r -- '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
    print -r -- '<plist version="1.0">'
    print -r -- '<dict>'
    print -r -- "  <key>Label</key><string>$LABEL</string>"
    print -r -- '  <key>ProgramArguments</key>'
    print -r -- '  <array>'
    for a in "${args[@]}"; do print -r -- "    <string>$(xml_escape "$a")</string>"; done
    print -r -- '  </array>'
    print -r -- '  <key>RunAtLoad</key><true/>'
    print -r -- '  <key>KeepAlive</key><true/>'
    print -r -- "  <key>StandardOutPath</key><string>$(xml_escape "$LOG_DIR/spoofdpi.log")</string>"
    print -r -- "  <key>StandardErrorPath</key><string>$(xml_escape "$LOG_DIR/spoofdpi.log")</string>"
    print -r -- '</dict>'
    print -r -- '</plist>'
  } > "$PLIST"
  plutil -lint "$PLIST" >/dev/null || die "Generated LaunchAgent is invalid: $PLIST" "Oluşturulan LaunchAgent geçersiz: $PLIST"
}

agent_start() {
  launchctl enable "$DOMAIN/$LABEL" 2>/dev/null
  agent_loaded || launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null || return 1
  local i
  for i in {1..20}; do port_open && return 0; sleep 0.5; done
  return 1
}

# `disable` survives reboots: "off" stays off until you say "on".
agent_stop() {
  agent_loaded && launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null
  launchctl disable "$DOMAIN/$LABEL" 2>/dev/null
  local i
  for i in {1..10}; do agent_loaded || return 0; sleep 0.5; done
}

# ---- Probes ----
# online | captive | offline — asked directly, never through the proxy.
internet_state() {
  local body
  body=$(curl -s --noproxy '*' -m 5 "$PROBE_URL" 2>/dev/null) || { print offline; return }
  [[ "$body" == *Success* ]] && print online || print captive
}

code_via_proxy() { curl -s -m "${2:-10}" -x "$PROXY_URL" -o /dev/null -w '%{http_code}' "$1" 2>/dev/null }
code_ok()        { [[ "$1" == [23]?? ]] }
proxy_alive()    { code_ok "$(code_via_proxy https://www.google.com 8)" }
url_host()       { local h=${1#*://}; print -r -- "${h%%[/:?]*}" }

# ---- Commands ----
cmd_install() {
  local bin ver
  bin=$(find_spoofdpi) || die \
    "SpoofDPI not found. Install it first: brew install spoofdpi" \
    "SpoofDPI bulunamadı. Önce kur: brew install spoofdpi"
  ver=$(spoofdpi_version "$bin")
  [[ "${ver%%.*}" == <1-> ]] || die \
    "spoofmac needs SpoofDPI 1.x (found ${ver:-a pre-1.0 build} at $bin). Update: brew upgrade spoofdpi" \
    "spoofmac SpoofDPI 1.x ister ($bin: ${ver:-1.0 öncesi bir sürüm}). Güncelle: brew upgrade spoofdpi"

  # Something else on our port (brew services, an older setup) would silently take our traffic.
  if port_open && ! agent_loaded; then
    die "Port $LISTEN_PORT is already taken by $(port_owner). Stop it first (e.g. brew services stop spoofdpi) or set LISTEN_PORT in $CONFIG_FILE." \
        "$LISTEN_PORT portunu zaten $(port_owner) kullanıyor. Önce onu durdur (ör. brew services stop spoofdpi) ya da $CONFIG_FILE içinde LISTEN_PORT'u değiştir."
  fi

  if [[ ! -f "$CONFIG_FILE" ]]; then
    mkdir -p "$CONFIG_DIR"
    cat > "$CONFIG_FILE" <<EOF
# spoofmac config (zsh). Uncomment to change a default, then run: spoofmac install
SPOOFDPI_BIN="$bin"
# LISTEN_PORT="8080"
# DOH_URL="https://1.1.1.1/dns-query"
# SPLIT_MODE="chunk"          # chunk | random | sni | none
# CHUNK_SIZE="5"              # try 1 if 5 stops working
# EXTRA_ARGS=(--https-disorder)
# TEST_URL="https://discord.com/api/v9/gateway"
EOF
  fi

  agent_stop                  # so a rewritten plist is picked up
  write_plist "$bin"
  say "SpoofDPI $ver · LaunchAgent: $PLIST" "SpoofDPI $ver · LaunchAgent: $PLIST"
  cmd_on
}

cmd_on() {
  [[ -f "$PLIST" ]] || die "Not installed yet. Run: spoofmac install" "Henüz kurulmadı. Çalıştır: spoofmac install"
  local state; state=$(internet_state)
  if [[ "$state" == captive && "${1:-}" != --force ]]; then
    die "This network wants you to log in first (captive portal). Run: spoofmac portal" \
        "Bu ağ önce giriş yapmanı istiyor (captive portal). Çalıştır: spoofmac portal"
  fi
  agent_start || die "SpoofDPI did not start. Log: $LOG_DIR/spoofdpi.log" "SpoofDPI başlamadı. Log: $LOG_DIR/spoofdpi.log"
  proxy_on
  dscacheutil -flushcache 2>/dev/null

  if proxy_alive; then
    say "✓ SpoofDPI is on — system proxy $PROXY_URL" "✓ SpoofDPI açık — sistem proxy'si $PROXY_URL"
  elif [[ "$state" == offline ]]; then
    say "✓ SpoofDPI is on. You're offline right now; it will work once the network is back." \
        "✓ SpoofDPI açık. Şu an internet yok; ağ gelince çalışır."
  else
    # Online, but not through SpoofDPI: a proxy that goes nowhere means no internet at all.
    proxy_off
    agent_stop
    die "SpoofDPI started but can't reach the internet on this network, so it was switched off again. See: spoofmac doctor" \
        "SpoofDPI başladı ama bu ağda internete çıkamıyor, o yüzden tekrar kapatıldı. Bak: spoofmac doctor"
  fi
}

cmd_off() {
  proxy_off                   # proxy first, so nothing is left pointing at a dead port
  agent_stop
  dscacheutil -flushcache 2>/dev/null
  say "✓ SpoofDPI is off — direct connection" "✓ SpoofDPI kapalı — doğrudan bağlantı"
}

cmd_portal() {
  cmd_off >/dev/null
  say "SpoofDPI paused for the Wi-Fi login." "Wi-Fi girişi için SpoofDPI durduruldu."

  if [[ -n "${1:-}" ]]; then
    local dev i; dev=$(wifi_device)
    [[ -n "$dev" ]] || die "No Wi-Fi interface found." "Wi-Fi arayüzü bulunamadı."
    say "Joining \"$1\"..." "\"$1\" ağına bağlanılıyor..."
    networksetup -setairportnetwork "$dev" "$1" ${2:+"$2"} || die "Could not join \"$1\"." "\"$1\" ağına bağlanılamadı."
    for i in {1..20}; do [[ -n "$(ipconfig getifaddr "$dev" 2>/dev/null)" ]] && break; sleep 1; done
    sleep 2                   # DHCP done; give the portal a moment to start intercepting
  fi

  case "$(internet_state)" in
    online)
      say "No login page — you're already online. Turn SpoofDPI back on: spoofmac on" \
          "Giriş sayfası yok, internet zaten açık. SpoofDPI'ı geri açmak için: spoofmac on" ;;
    captive)
      open "http://captive.apple.com"   # plain HTTP, so the portal can intercept and redirect it
      say "Login page opened in your browser. When you're done: spoofmac on" \
          "Giriş sayfası tarayıcıda açıldı. Girişi bitirince: spoofmac on" ;;
    offline)
      say "No internet yet. If no login page shows up, open http://captive.apple.com yourself. Then: spoofmac on" \
          "Henüz internet yok. Giriş sayfası çıkmazsa http://captive.apple.com adresini elle aç. Sonra: spoofmac on" ;;
  esac
}

cmd_status() {
  local bin ver="?" s any=0 code
  bin=$(find_spoofdpi) && ver=$(spoofdpi_version "$bin")
  print -r -- "spoofmac $SPOOFMAC_VERSION · SpoofDPI ${ver:-?}"

  if port_open && agent_loaded; then
    row "SpoofDPI" "$(t "running on $LISTEN_HOST:$LISTEN_PORT" "çalışıyor, $LISTEN_HOST:$LISTEN_PORT")"
  elif port_open; then
    row "SpoofDPI" "$(t "port $LISTEN_PORT is used by $(port_owner), not spoofmac" "$LISTEN_PORT portunu spoofmac değil $(port_owner) kullanıyor")"
  else
    row "SpoofDPI" "$(t stopped durdu)"
  fi

  for s in "${(@f)$(network_services)}"; do
    proxy_is_ours "$s" && { row "$(t "System proxy" "Sistem proxy'si")" "$s → $PROXY_URL"; any=1 }
  done
  (( any )) || row "$(t "System proxy" "Sistem proxy'si")" "$(t off kapalı)"

  case "$(internet_state)" in
    online)  row "$(t Internet İnternet)" "$(t online açık)" ;;
    captive) row "$(t Internet İnternet)" "$(t "login page waiting → spoofmac portal" "giriş sayfası bekliyor → spoofmac portal")" ;;
    offline) row "$(t Internet İnternet)" "$(t offline yok)" ;;
  esac

  if port_open; then
    code=$(code_via_proxy "$TEST_URL")
    if code_ok "$code"; then row "$(t Test Test)" "✓ $(url_host "$TEST_URL") → $code"
    else row "$(t Test Test)" "✗ $(url_host "$TEST_URL") → ${code:-000} ($(t "run: spoofmac doctor" "çalıştır: spoofmac doctor"))"
    fi
  fi
}

doh_ips() {
  curl -s --noproxy '*' -m 6 -H 'accept: application/dns-json' "https://1.1.1.1/dns-query?name=$1&type=A" 2>/dev/null |
    grep -oE '"data":"[0-9.]+"' | cut -d'"' -f4
}
system_ip()  { dscacheutil -q host -a name "$1" 2>/dev/null | awk '/^ip_address/ {print $2; exit}' }
udp53_ip()   { dig +short +time=2 +tries=1 @1.1.1.1 "$1" A 2>/dev/null | grep -E '^[0-9.]+$' | head -1 }

cmd_doctor() {
  local host="${1:-$(url_host "$TEST_URL")}" state sys udp code rc
  local -a doh
  print -r -- "spoofmac doctor · $host"
  print

  state=$(internet_state)
  row "$(t Internet İnternet)" "$state"
  [[ "$state" == captive ]] && say "→ Log in first: spoofmac portal" "→ Önce giriş yap: spoofmac portal"

  doh=( ${(f)"$(doh_ips "$host")"} )
  sys=$(system_ip "$host")
  udp=$(udp53_ip "$host")

  local dns_bad=0
  row "DoH (1.1.1.1)" "${doh[*]:-$(t "no answer" "yanıt yok")}"
  if [[ -n "$sys" && ${#doh} -gt 0 && ${doh[(Ie)$sys]} -eq 0 ]]; then
    dns_bad=1
    row "$(t "System DNS" "Sistem DNS'i")" "✗ $sys — $(t "differs from DoH: DNS is tampered with" "DoH'tan farklı: DNS'e müdahale var")"
  else
    row "$(t "System DNS" "Sistem DNS'i")" "${sys:-$(t "no answer" "yanıt yok")}"
  fi
  if [[ -z "$udp" ]]; then
    row "$(t "Plain DNS (UDP 53)" "Düz DNS (UDP 53)")" "$(t "blocked" "kapalı")"
  elif (( ${#doh} )) && (( ${doh[(Ie)$udp]} == 0 )); then
    row "$(t "Plain DNS (UDP 53)" "Düz DNS (UDP 53)")" "✗ $udp — $(t "hijacked" "yolda değiştiriliyor")"
  else
    row "$(t "Plain DNS (UDP 53)" "Düz DNS (UDP 53)")" "$udp"
  fi

  # Direct HTTPS to the *real* IP: DNS is out of the picture, only DPI/SNI filtering is left.
  local dpi_bad=0
  if (( ${#doh} )); then
    curl -s --noproxy '*' -m 8 -o /dev/null --resolve "$host:443:${doh[1]}" "https://$host/" 2>/dev/null
    rc=$?
    case $rc in
      0)        row "$(t "Direct HTTPS" "Doğrudan HTTPS")" "✓ $(t ok açık)" ;;
      35|52|56) dpi_bad=1; row "$(t "Direct HTTPS" "Doğrudan HTTPS")" "✗ $(t "reset during TLS — SNI/DPI filtering" "TLS sırasında koparıldı — SNI/DPI filtresi")" ;;
      28)       dpi_bad=1; row "$(t "Direct HTTPS" "Doğrudan HTTPS")" "✗ $(t "timed out — IP block or DPI" "zaman aşımı — IP engeli ya da DPI")" ;;
      *)        dpi_bad=1; row "$(t "Direct HTTPS" "Doğrudan HTTPS")" "✗ curl exit $rc" ;;
    esac
  fi

  local spoof_ok=0
  if port_open; then
    code=$(code_via_proxy "https://$host/")
    code_ok "$code" && spoof_ok=1
    row "$(t "Via SpoofDPI" "SpoofDPI üstünden")" "$( (( spoof_ok )) && print "✓ $code" || print "✗ ${code:-000}")"
  else
    row "$(t "Via SpoofDPI" "SpoofDPI üstünden")" "$(t "not running (spoofmac on)" "çalışmıyor (spoofmac on)")"
  fi

  print
  if (( ! dns_bad && ! dpi_bad )); then
    say "Verdict: nothing blocks $host on this network." "Sonuç: bu ağda $host için engel yok."
  elif (( dns_bad && ! dpi_bad )); then
    say "Verdict: only DNS is blocked. SpoofDPI fixes it (so would any DoH resolver)." \
        "Sonuç: yalnız DNS engelli. SpoofDPI çözer (herhangi bir DoH çözücü de çözerdi)."
  else
    say "Verdict: SNI/DPI filtering$( (( dns_bad )) && print " + DNS tampering"). SpoofDPI is needed, and apps that ignore the system proxy need a launcher: spoofmac app <App>" \
        "Sonuç: SNI/DPI filtresi$( (( dns_bad )) && print " + DNS müdahalesi"). SpoofDPI şart; sistem proxy'sini kullanmayan uygulamalar için başlatıcı gerekir: spoofmac app <Uygulama>"
  fi
  if port_open && (( ! spoof_ok )); then
    say "SpoofDPI didn't get through either. Try SPLIT_MODE=\"random\" or CHUNK_SIZE=\"1\" in $CONFIG_FILE, then: spoofmac install" \
        "SpoofDPI de geçemedi. $CONFIG_FILE içinde SPLIT_MODE=\"random\" ya da CHUNK_SIZE=\"1\" dene, sonra: spoofmac install"
  fi
}

# A tiny app that starts <App> with HTTPS_PROXY set. Some apps ship their own HTTP client
# that ignores the macOS system proxy but honours these variables (Discord's updater does).
cmd_app() {
  local target="${1:-}" src="" c name dest info icon_file icon
  [[ -n "$target" ]] || die "Usage: spoofmac app <App name or path>" "Kullanım: spoofmac app <Uygulama adı ya da yolu>"

  if [[ -d "$target" ]]; then
    src=${target:A}
  else
    for c in "/Applications/$target.app" "$HOME/Applications/$target.app" "/System/Applications/$target.app"; do
      [[ -d "$c" ]] && { src=$c; break }
    done
    [[ -n "$src" ]] || src=$(mdfind "kMDItemContentType == 'com.apple.application-bundle' && kMDItemFSName == '$target.app'" 2>/dev/null | head -1)
  fi
  [[ -n "$src" && -d "$src" ]] || die "App not found: $target" "Uygulama bulunamadı: $target"

  name="${${src:t}%.app} SpoofDPI"
  local apps_dir="${SPOOFMAC_APPS_DIR:-/Applications}"
  [[ -w "$apps_dir" ]] || apps_dir="$HOME/Applications"
  mkdir -p "$apps_dir"
  dest="$apps_dir/$name.app"

  # Never write onto an existing bundle: mv/cp would nest the new one inside it and
  # break the code signature. Move the old one to the Trash instead.
  if [[ -e "$dest" ]]; then
    mv "$dest" "$HOME/.Trash/$name $(date +%Y%m%d-%H%M%S).app" ||
      die "Could not move the old $dest to the Trash." "Eski $dest Çöp Sepeti'ne taşınamadı."
  fi

  local envs="--env HTTPS_PROXY=$PROXY_URL --env HTTP_PROXY=$PROXY_URL --env NO_PROXY=localhost,127.0.0.1,::1"
  osacompile -o "$dest" -e "do shell script \"open -a \" & quoted form of \"$src\" & \" $envs\"" 2>/dev/null ||
    die "osacompile failed." "osacompile başarısız oldu."

  info="$dest/Contents/Info.plist"
  # Launchers without a bundle id are invisible to Raycast/Alfred.
  plutil -replace CFBundleIdentifier -string "local.spoofmac.launcher.${${(L)name}//[^a-z0-9]/-}" "$info"

  # Borrow the real app's icon. osacompile's Assets.car wins over applet.icns, so drop it.
  icon_file=$(plutil -extract CFBundleIconFile raw "$src/Contents/Info.plist" 2>/dev/null)
  icon="$src/Contents/Resources/${icon_file%.icns}.icns"
  if [[ -n "$icon_file" && -f "$icon" ]]; then
    cp "$icon" "$dest/Contents/Resources/applet.icns"
    plutil -remove CFBundleIconName "$info" 2>/dev/null
    rm -f "$dest/Contents/Resources/Assets.car"
  fi

  codesign --force --deep -s - "$dest" >/dev/null 2>&1 && codesign --verify "$dest" 2>/dev/null ||
    die "Could not sign $dest" "$dest imzalanamadı"
  touch "$dest"
  [[ -x "$LSREGISTER" ]] && "$LSREGISTER" -f "$dest" 2>/dev/null
  mdimport "$dest" 2>/dev/null

  say "✓ Created $dest
  Open ${src:t:r} with this from now on (Dock, Spotlight, Raycast). If ${src:t:r} is already
  running, quit it first (⌘Q) — an app that's already open keeps its old environment." \
      "✓ Oluşturuldu: $dest
  ${src:t:r} uygulamasını bundan sonra bununla aç (Dock, Spotlight, Raycast). ${src:t:r} zaten
  açıksa önce kapat (⌘Q) — açık bir uygulama eski ortamıyla devam eder."
}

cmd_shellenv() {
  if [[ "${1:-}" == --unset ]]; then
    print -r -- "unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy NO_PROXY no_proxy"
  else
    print -r -- "export HTTP_PROXY=$PROXY_URL HTTPS_PROXY=$PROXY_URL http_proxy=$PROXY_URL https_proxy=$PROXY_URL"
    print -r -- "export NO_PROXY=localhost,127.0.0.1,::1,.local no_proxy=localhost,127.0.0.1,::1,.local"
  fi
}

cmd_logs() {
  [[ -f "$LOG_DIR/spoofdpi.log" ]] || die "No log yet: $LOG_DIR/spoofdpi.log" "Henüz log yok: $LOG_DIR/spoofdpi.log"
  tail -n 50 -f "$LOG_DIR/spoofdpi.log"
}

cmd_uninstall() {
  cmd_off >/dev/null
  [[ -f "$PLIST" ]] && rm -f "$PLIST"
  say "✓ SpoofDPI stopped and its LaunchAgent removed. Kept: $CONFIG_DIR, launchers (*SpoofDPI.app), the spoofmac command." \
      "✓ SpoofDPI durduruldu, LaunchAgent'ı silindi. Duruyor: $CONFIG_DIR, başlatıcılar (*SpoofDPI.app), spoofmac komutu."
}

usage() {
  say "spoofmac $SPOOFMAC_VERSION — SpoofDPI on macOS, minus the pain

  spoofmac install          set up SpoofDPI to run in the background and turn it on
  spoofmac on | off         turn SpoofDPI + the system proxy on / off
  spoofmac portal [WIFI]    public Wi-Fi: pause SpoofDPI, (join WIFI,) open the login page
  spoofmac status           what's running, where the proxy points, are we online
  spoofmac doctor [HOST]    what blocks HOST here: DNS, SNI/DPI, or nothing
  spoofmac app <APP>        make \"<APP> SpoofDPI.app\" for apps that ignore the system proxy
  spoofmac shellenv         proxy variables for your shell: eval \"\$(spoofmac shellenv)\"
  spoofmac logs             follow the SpoofDPI log
  spoofmac uninstall        stop and remove the background service

Internet gone? Run: spoofmac off" \
      "spoofmac $SPOOFMAC_VERSION — macOS'ta SpoofDPI, derdi olmadan

  spoofmac install          SpoofDPI'ı arka planda çalışacak şekilde kur ve aç
  spoofmac on | off         SpoofDPI + sistem proxy'sini aç / kapat
  spoofmac portal [WIFI]    halka açık Wi-Fi: SpoofDPI'ı durdur, (WIFI'ye bağlan,) giriş sayfasını aç
  spoofmac status           ne çalışıyor, proxy nereyi gösteriyor, internet var mı
  spoofmac doctor [ADRES]   bu ağda ADRES'i ne engelliyor: DNS, SNI/DPI ya da hiçbir şey
  spoofmac app <UYGULAMA>   sistem proxy'sini kullanmayan uygulamalar için \"<UYGULAMA> SpoofDPI.app\"
  spoofmac shellenv         terminal için proxy değişkenleri: eval \"\$(spoofmac shellenv)\"
  spoofmac logs             SpoofDPI logunu izle
  spoofmac uninstall        arka plan servisini durdur ve kaldır

İnternet gitti mi? Çalıştır: spoofmac off"
}

case "${1:-help}" in
  install)              cmd_install ;;
  on|resume)            shift; cmd_on "$@" ;;
  off)                  cmd_off ;;
  portal)               shift; cmd_portal "$@" ;;
  status)               cmd_status ;;
  doctor)               shift; cmd_doctor "$@" ;;
  app)                  shift; cmd_app "$@" ;;
  shellenv)             shift; cmd_shellenv "$@" ;;
  logs)                 cmd_logs ;;
  uninstall)            cmd_uninstall ;;
  version|-v|--version) print -r -- "spoofmac $SPOOFMAC_VERSION" ;;
  help|-h|--help)       usage ;;
  *)                    usage >&2; exit 64 ;;
esac
